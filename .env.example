# ================= RD-Agent + Qwen (DashScope) configuration =================
# Copy to .env and fill in your key. DashScope console:
#   China:          https://dashscope.console.aliyun.com/
#   International:  https://www.alibabacloud.com/en/solutions/generative-ai/model-studio

# Chat model used by all RD-Agent loops (agent planning, coding, feedback)
CHAT_MODEL=openai/qwen3-max
# Embedding model (used for retrieval/knowledge components)
EMBEDDING_MODEL=openai/text-embedding-v4

# China-region accounts:
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# International accounts:
OPENAI_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-dashscope-api-key

# Qwen3 models can wrap reasoning in <think>…</think>; strip it from outputs
REASONING_THINK_RM=true

# --- Code execution environment for generated code ---
# "conda" = run directly inside the container Python (works out of the box)
# "docker" = run in containers (mount /var/run/docker.sock, see docker-compose.yml)
DS_Coder_CoSTEER_env_type=conda
MODEL_CoSTEER_env_type=conda

# --- Optional model overrides per step (LiteLLM model map) ---
# e.g. use a coder-specialised model for coding steps:
# CHAT_MODEL_MAP={"coding":{"model":"openai/qwen3-coder-plus"}}
